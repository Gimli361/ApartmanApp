@model DashboardViewModel
@{
    ViewData["Title"] = "Gösterge Paneli";
}

<h4 class="mb-4 fw-bold"><i class="bi bi-speedometer2 me-2 text-primary"></i>Gösterge Paneli</h4>

<!-- İstatistik Kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card text-white" style="background:linear-gradient(135deg,#3b82f6,#2563eb);">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small fw-semibold opacity-75 mb-1">Toplam Sakin</div>
                    <h2 class="mb-0 fw-bold">@Model.ToplamSakin</h2>
                </div>
                <i class="bi bi-people-fill opacity-50" style="font-size:2.4rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card text-dark" style="background:linear-gradient(135deg,#fbbf24,#f59e0b);">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small fw-semibold opacity-75 mb-1">Bekleyen Arıza</div>
                    <h2 class="mb-0 fw-bold">@Model.BekleyenAriza</h2>
                </div>
                <i class="bi bi-tools opacity-50" style="font-size:2.4rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card text-white" style="background:linear-gradient(135deg,#06b6d4,#0891b2);">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small fw-semibold opacity-75 mb-1">Ödenmemiş Aidat</div>
                    <h2 class="mb-0 fw-bold">@Model.OdenmemisAidat</h2>
                </div>
                <i class="bi bi-cash-coin opacity-50" style="font-size:2.4rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card text-white" style="background:linear-gradient(135deg,#ef4444,#dc2626);">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small fw-semibold opacity-75 mb-1">Kritik Arıza</div>
                    <h2 class="mb-0 fw-bold">@Model.KritikAriza</h2>
                </div>
                <i class="bi bi-exclamation-triangle-fill opacity-50" style="font-size:2.4rem;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Son Arızalar -->
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Son Arızalar</h6>
        <a href="/Arizalar" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
    </div>
    <div class="card-body p-0">
        @if (Model.SonArizalar.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Daire</th>
                            <th>Öncelik</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ariza in Model.SonArizalar)
                        {
                            <tr onclick="window.location='/Arizalar/Detay/@ariza.Id'" title="Detayı görüntüle">
                                <td class="fw-medium">@ariza.Baslik</td>
                                <td>@ariza.BildirenDaireNo</td>
                                <td><span class="badge badge-durum oncelik-@ariza.Oncelik.ToLower()">@ariza.Oncelik</span></td>
                                <td><span class="badge badge-durum durum-@ariza.Durum.ToLower()">@ariza.Durum</span></td>
                                <td class="text-muted small">@ariza.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>Henüz arıza kaydı bulunmuyor.</p>
            </div>
        }
    </div>
</div>
