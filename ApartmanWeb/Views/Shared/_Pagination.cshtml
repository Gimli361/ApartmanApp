@model PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Sayfa gezinmesi" class="mt-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="text-muted small">
                Toplam <strong>@Model.TotalCount</strong> kayıt — sayfa @Model.Page / @Model.TotalPages
            </div>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlFor(1)" aria-label="İlk">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlFor(Model.Page - 1)" aria-label="Önceki">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    var start = Math.Max(1, Model.Page - 2);
                    var end = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @for (int p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Model.UrlFor(p)">@p</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlFor(Model.Page + 1)" aria-label="Sonraki">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlFor(Model.TotalPages)" aria-label="Son">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    </nav>
}
