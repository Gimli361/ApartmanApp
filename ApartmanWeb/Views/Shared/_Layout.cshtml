@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@csrfToken" />
    <title>@ViewData["Title"] — Apartman Yönetim</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar bg-dark text-white" id="sidebar">
            <div class="sidebar-header p-3 d-flex align-items-center gap-2">
                <i class="bi bi-building fs-5 text-primary"></i>
                <h6 class="mb-0 fw-bold text-white">Apartman Yönetim</h6>
            </div>
            <nav class="nav flex-column p-2 flex-grow-1">
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Gösterge Paneli
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Binam" ? "active" : "")"
                   asp-controller="Binam" asp-action="Index">
                    <i class="bi bi-building me-2"></i> Binam
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kullanicilar" ? "active" : "")"
                   asp-controller="Kullanicilar" asp-action="Index">
                    <i class="bi bi-people me-2"></i> Üye Yönetimi
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Arizalar" ? "active" : "")"
                   asp-controller="Arizalar" asp-action="Index">
                    <i class="bi bi-tools me-2"></i> Arıza Yönetimi
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Aidatlar" ? "active" : "")"
                   asp-controller="Aidatlar" asp-action="Index">
                    <i class="bi bi-cash-coin me-2"></i> Aidat Yönetimi
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bildirimler" ? "active" : "")"
                   asp-controller="Bildirimler" asp-action="Index">
                    <i class="bi bi-bell me-2"></i> Bildirimler
                </a>
                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Oylamalar" ? "active" : "")"
                   asp-controller="Oylamalar" asp-action="Index">
                    <i class="bi bi-check2-square me-2"></i> Oylamalar
                </a>
            </nav>
            <div class="p-3 border-top border-secondary">
                <a class="d-flex align-items-center gap-2 mb-2 text-decoration-none"
                   asp-controller="Profil" asp-action="Index" title="Profilim">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width:32px;height:32px;min-width:32px;">
                        <i class="bi bi-person-fill text-white small"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-white small fw-semibold text-truncate">@User.Identity?.Name</div>
                        <div class="text-muted-sm">Profilim</div>
                    </div>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div class="flex-grow-1 d-flex flex-column" id="page-content">
            <nav class="page-topbar d-flex align-items-center">
                <button class="btn btn-sm btn-outline-secondary d-md-none me-2"
                        onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-semibold text-secondary small">@ViewData["Title"]</span>
                <div class="ms-auto text-muted-sm">
                    <i class="bi bi-clock me-1"></i>
                    <span id="saatGoster"></span>
                </div>
            </nav>
            <main class="flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Global Confirm Modal -->
    <div class="modal fade" id="_confirmModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Onay Gerekiyor
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 pb-2">
                    <p class="mb-0 text-secondary small" id="_confirmMsg"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-danger btn-sm" id="_confirmBtn">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // Üst çubuk saat
    (function tick() {
        const el = document.getElementById('saatGoster');
        if (el) el.textContent = new Date().toLocaleTimeString('tr-TR', {hour:'2-digit',minute:'2-digit'});
        setTimeout(tick, 10000);
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
